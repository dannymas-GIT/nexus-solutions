# Nexus Solutions Backend Environment Template
# Copy to .env and populate secrets from your secret store (never commit real credentials).

# CORS allowed origins (comma-separated)
BACKEND_CORS_ORIGINS=https://nexus-solutions.us,https://www.nexus-solutions.us,http://localhost:3000,http://localhost:5173

# Operator API key for /api/v1/auth/bootstrap, /api/v1/storage/*, and /api/v1/leads admin listing (falls back to PORTAL_API_KEY)
NEXUS_ADMIN_API_KEY=

# Client deliverable portal (Income Scout / Greenhouse)
PORTAL_API_KEY=
PORTAL_JWT_SECRET=
PORTAL_PUBLIC_BASE=https://nexus-solutions.us
PORTAL_BUNDLE_ROOT=./data/portal_bundles
DATABASE_URL=

# Optional SES email notifications (portal magic links & audit lead alerts)
AWS_REGION=us-east-1
SES_SOURCE_EMAIL=
LEADS_NOTIFY_EMAIL=

# Storage configuration (local | onedrive | sharepoint)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./output
ONEDRIVE_ROOT_FOLDER=NexusSolutions

# Optional Microsoft 365 / Azure AD (only when STORAGE_PROVIDER=onedrive or sharepoint)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
CERT_PATH=
CERT_PASSWORD=
GRAPH_API_VERSION=v1.0

# Idea Studio (shared TheHelm control-api integration)
IDEA_STUDIO_API_BASE_URL=
IDEA_STUDIO_PUBLIC_URL=
IDEA_STUDIO_TENANT_ID=nexus-solutions
IDEA_STUDIO_STAGING_DOMAIN=nexus-solutions.us
IDEA_STUDIO_API_TOKEN=
IDEA_STUDIO_TIMEOUT_SECONDS=180
